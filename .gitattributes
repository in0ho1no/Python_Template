###############################################################################
# 基本方針
# - リポジトリ内はLFに統一（CI・Linux・Macと整合）
# - Windows固有ファイルのみCRLF
###############################################################################

* text=auto

###############################################################################
# 改行コードの明示（重要）
###############################################################################

# ソースコード・設定ファイルはLF固定
*.c      text eol=lf
*.h      text eol=lf
*.cpp    text eol=lf
*.hpp    text eol=lf
*.cc     text eol=lf

*.py     text eol=lf
*.js     text eol=lf
*.ts     text eol=lf
*.jsx    text eol=lf
*.tsx    text eol=lf

*.json   text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.toml   text eol=lf
*.ini    text eol=lf

*.md     text eol=lf
*.txt    text eol=lf

# シェルスクリプト（CRLF混入防止）
*.sh     text eol=lf

# Windows専用スクリプトはCRLF
*.bat    text eol=crlf
*.cmd    text eol=crlf
*.ps1    text eol=crlf

###############################################################################
# バイナリ（変換・差分対象外）
###############################################################################

# 画像
*.png binary
*.jpg binary
*.jpeg binary
*.bmp binary
*.tiff binary
*.gif binary
*.ico binary

# 実行ファイル
*.exe binary
*.dll binary

# 圧縮ファイル
*.zip binary
*.tar binary
*.gz binary
*.7z binary

# Office / PDF
*.xlsx binary
*.xls binary
*.docx binary
*.doc binary
*.pptx binary
*.ppt binary
*.pdf binary

# メディア
*.mp3 binary
*.mp4 binary
*.mov binary

###############################################################################
# diffノイズ抑制（レビュー効率）
###############################################################################

*.pdf  -diff
*.xlsx -diff
*.docx -diff
*.pptx -diff

###############################################################################
# マージ戦略（コンフリクト回避）
# ※ チームルールとセットで運用すること
###############################################################################

# Node系
package-lock.json merge=ours
yarn.lock         merge=ours

# Python系
poetry.lock       merge=ours
Pipfile.lock      merge=ours

###############################################################################
# 生成物（差分・言語統計から除外）
###############################################################################

dist/**   linguist-generated
build/**  linguist-generated
out/**    linguist-generated

###############################################################################
# ドキュメント扱い
###############################################################################

*.md linguist-documentation

###############################################################################
# バイナリ扱いの明示（念のため）
###############################################################################

*.bin binary
*.dat binary
